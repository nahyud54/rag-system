# ===================================
# RAG System Environment Variables
# ===================================

# ===== SERVER =====
FAST_API_HOST=0.0.0.0
FAST_API_PORT=8000
DEBUG=True

# ===== FRONTEND =====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT=30000

# ===== LLM Configuration =====
# Options: qwen2.5, llama2, gpt-3.5-turbo, gpt-4, etc.
LLM_MODEL=qwen2.5
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=http://localhost:11434  # For local Ollama
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ===== EMBEDDING Configuration =====
# Model: paraphrase-multilingual-MiniLM-L12-v2, sentence-transformers, etc.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu  # or cuda for GPU

# ===== VECTOR STORE Configuration =====
# Type: chroma, pinecone, weaviate, milvus, etc.
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./data/chroma_db

# Pinecone (if using pinecone)
PINCONE_API_KEY=
PINCONE_INDEX_NAME=rag-index
PINCONE_ENVIRONMENT=gcp-starter

# Weaviate (if using weaviate)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# ===== RETRIEVAL Configuration =====
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.5
USE_MULTI_QUERY=True
USE_HYDE=False
USE_RERANKING=True

# ===== RERANKER Configuration =====
# Model: cross-encoder/ms-marco-MiniLM-L-6-v2, etc.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_THRESHOLD=0.5

# ===== INDEXING Configuration =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100

# ===== CRAWLING Configuration =====
COOKIES_PATH=./cookies.json
CRAWL_TIMEOUT=30
MAX_RETRIES=3

# ===== LOGGING =====
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text

# ===== DATABASE =====
DATABASE_URL=sqlite:///./data/rag.db

# ===== CORS =====
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_CREDENTIALS=True
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# ===== SESSION =====
SESSION_TIMEOUT=3600  # 1 hour in seconds
MAX_SESSIONS=100

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=False
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds
